{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luka",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Served at <name>.<subdomain>.workers.dev. Preview URLs stay off: a preview version
  // would run against the same Durable Objects as the live one.
  "workers_dev": true,
  "preview_urls": false,
  // Telemetry is structured logs (src/telemetry.ts) plus automatic traces, kept in Workers
  // Observability. To also export them over OpenTelemetry, create an OTLP destination in
  // the Cloudflare dashboard and list its name under `logs` and/or `traces`, e.g.
  // "destinations": ["<destination name>"].
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  },
  "durable_objects": {
    "bindings": [
      // One per Dexcom username: session state, tokens, and the poll alarm.
      { "name": "USER_SESSION", "class_name": "UserSession" },
      // Singleton: activity counts for /activity-count and the shared APNs JWT.
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserSession", "Registry"] }],
  "env": {
    // A separate Worker with its own Durable Objects, so trials never share state with
    // production. Named environments inherit `migrations` and `observability`, but not
    // `durable_objects`, which has to be repeated here.
    "staging": {
      "name": "luka-staging",
      "durable_objects": {
        "bindings": [
          { "name": "USER_SESSION", "class_name": "UserSession" },
          { "name": "REGISTRY", "class_name": "Registry" }
        ]
      }
    }
  }
  // Secrets, all optional (set with `wrangler secret put`; locally in `.dev.vars`, see
  // `.dev.vars.example`): PUSH_NOTIFICATION_PEM, PUSH_NOTIFICATION_ID, TEAM_IDENTIFIER.
  // Without them APNs is a no-op. They're typed in src/secrets.ts rather than generated,
  // since they may be absent.
}
