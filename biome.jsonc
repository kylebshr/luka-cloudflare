{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // worker-configuration.d.ts is generated by `wrangler types`. Markdown is left as
  // written: the formatter pads every table column to the widest cell.
  "files": { "includes": ["**", "!worker-configuration.d.ts", "!**/*.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "style": {
            // In a test, a value that's unexpectedly missing fails the test either way.
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            // Assertions reach into APNs payloads and stored JSON, which tests leave untyped.
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
